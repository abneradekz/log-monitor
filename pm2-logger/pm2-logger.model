module(load="imfile")

# --- Log de Saída (INFO) ---
# Ajuste o nome do arquivo se necessário
input(type="imfile"
      File="/root/.pm2/logs/modelo-out.log"
      Tag="pm2-modelo"
      Severity="info"
      Facility="local0")

# --- Log de Erro (ERROR) ---
# Ajuste o nome do arquivo se necessário
input(type="imfile"
      File="/root/.pm2/logs/modelo-error.log"
      Tag="pm2-modelo-err"
      Severity="error"
      Facility="local0")